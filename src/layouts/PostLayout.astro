---
import type { MarkdownHeading } from 'astro';
import CodeCopy from '../components/CodeCopy.astro';
import PostCard from '../components/PostCard.astro';
import { topicConfig } from '../config/site';
import { getPostCollection } from '../lib/post-collection';
import { isPublished, sortNewest, type Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  neighbors: { previous?: Post; next?: Post };
}

const { post, headings, neighbors } = Astro.props;
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const mode = import.meta.env.PROD ? 'production' : 'development';
const relatedPosts = sortNewest(
  (await getPostCollection()).filter(
    (candidate) =>
      isPublished(candidate, mode) &&
      candidate.id !== post.id &&
      candidate.data.topic === post.data.topic
  )
).slice(0, 3);
const topic = topicConfig[post.data.topic];
const showEnvironment = post.data.testedVersions.length > 0;
const showPrerequisites = post.data.prerequisites.length > 0;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  publishedDate={post.data.draft ? undefined : post.data.publishedDate}
  updatedDate={post.data.updatedDate}
  article
>
  <div class="shell article-shell">
    <article class="article" data-pagefind-body>
      <span class="pagefind-filter" data-pagefind-filter={`topic:${post.data.topic}`} aria-hidden="true"></span>
      <span class="pagefind-filter" data-pagefind-filter={`difficulty:${post.data.difficulty}`} aria-hidden="true"></span>

      <header class="article-header">
        <div class="article-header__main">
          <p class="eyebrow">{topic.label} · {post.data.draft ? 'Draft preview' : 'Field note'}</p>
          <h1 data-pagefind-meta="title">{post.data.title}</h1>
          <p class="article-summary">{post.data.description}</p>
        </div>
        <aside class="article-register" aria-labelledby="article-register-title">
          <h2 class="eyebrow" id="article-register-title">Field note register</h2>
          <dl>
            <div>
              <dt>Topic</dt>
              <dd>{topic.label}</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{post.data.kind === 'lab' ? 'Lab' : 'Guide'}</dd>
            </div>
            <div>
              <dt>Difficulty</dt>
              <dd>{post.data.difficulty}</dd>
            </div>
            <div>
              <dt>Time</dt>
              <dd>{post.data.estimatedMinutes} minutes</dd>
            </div>
            <div>
              <dt>{post.data.draft ? 'Draft date' : 'Published'}</dt>
              <dd><time datetime={post.data.publishedDate.toISOString()}>{formatDate(post.data.publishedDate)}</time></dd>
            </div>
            {post.data.updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></dd>
              </div>
            )}
          </dl>
        </aside>
      </header>

      {(showEnvironment || showPrerequisites) && (
        <div class:list={['article-setup', { 'article-setup--single': showEnvironment !== showPrerequisites }]}>
          {showEnvironment && (
            <section class="setup-panel" aria-labelledby="tested-versions-title">
              <p class="eyebrow">Environment</p>
              <h2 id="tested-versions-title">Tested versions</h2>
              <ul>
                {post.data.testedVersions.map((version) => <li>{version}</li>)}
              </ul>
            </section>
          )}
          {showPrerequisites && (
            <section class="setup-panel" aria-labelledby="prerequisites-title">
              <p class="eyebrow">Before you begin</p>
              <h2 id="prerequisites-title">Prerequisites</h2>
              <ul>
                {post.data.prerequisites.map((prerequisite) => <li>{prerequisite}</li>)}
              </ul>
            </section>
          )}
        </div>
      )}

      <div class:list={['article-reading-grid', { 'article-reading-grid--without-toc': tableOfContents.length === 0 }]}>
        {tableOfContents.length > 0 && (
          <nav class="article-toc" aria-labelledby="table-of-contents-title">
            <p class="eyebrow">On this page</p>
            <h2 id="table-of-contents-title">Contents</h2>
            <ol>
              {tableOfContents.map((heading) => (
                <li class:list={{ 'article-toc__nested': heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="article-prose prose">
          <slot />
        </div>
      </div>
    </article>

    {(neighbors.previous || neighbors.next) && (
      <nav class="path-neighbors" aria-labelledby="path-neighbors-title">
        <h2 class="visually-hidden" id="path-neighbors-title">Continue this learning path</h2>
        {neighbors.previous && (
          <a class="path-neighbor path-neighbor--previous" href={`/articles/${neighbors.previous.id}/`}>
            <span>← Previous in path</span>
            <strong>{neighbors.previous.data.title}</strong>
          </a>
        )}
        {neighbors.next && (
          <a class="path-neighbor path-neighbor--next" href={`/articles/${neighbors.next.id}/`}>
            <span>Next in path →</span>
            <strong>{neighbors.next.data.title}</strong>
          </a>
        )}
      </nav>
    )}

    {relatedPosts.length > 0 && (
      <section class="related-posts" aria-labelledby="related-posts-title">
        <div class="section-heading">
          <h2 id="related-posts-title">More from {topic.label}</h2>
          <p>Continue with field notes from the same part of the workbench.</p>
        </div>
        <div class="related-posts__grid">
          {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} />)}
        </div>
      </section>
    )}

    <CodeCopy />
  </div>
</BaseLayout>

<style is:global>
  .pagefind-filter,
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .article-shell {
    border-right: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .article-header {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.65fr);
    border-bottom: 1px solid var(--rule);
  }

  .article-header__main {
    min-width: 0;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(1.25rem, 5vw, 4rem);
  }

  .article-header__main h1 {
    max-width: 14ch;
    margin: 1.1rem 0 1.5rem;
    font: 800 clamp(3rem, 7.5vw, 6.75rem) / 0.88 var(--font-display);
    letter-spacing: -0.05em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .article-summary {
    max-width: 42rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.5;
  }

  .article-register {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 1px solid var(--rule);
    background: var(--cluster);
    color: var(--paper);
  }

  .article-register > .eyebrow {
    color: var(--signal);
  }

  .article-register dl {
    display: grid;
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    border-top: 1px solid color-mix(in srgb, var(--rule) 55%, transparent);
  }

  .article-register dl > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 55%, transparent);
  }

  .article-register dt {
    color: var(--signal);
    font: 700 0.65rem/1.5 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .article-register dd {
    margin: 0;
    font-size: 0.86rem;
  }

  .article-register dd:first-letter {
    text-transform: uppercase;
  }

  .article-setup {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--rule);
    background: var(--wash);
  }

  .article-setup--single {
    grid-template-columns: 1fr;
  }

  .setup-panel {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .setup-panel + .setup-panel {
    border-left: 1px solid var(--rule);
  }

  .setup-panel h2,
  .article-toc h2 {
    margin: 0.45rem 0 1rem;
    font: 800 clamp(1.45rem, 3vw, 2.1rem) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .setup-panel ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.15rem;
  }

  .article-reading-grid {
    display: grid;
    grid-template-columns: minmax(13rem, 0.42fr) minmax(0, 1fr);
    align-items: start;
  }

  .article-reading-grid--without-toc {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-toc {
    position: sticky;
    top: 1rem;
    margin: clamp(2rem, 5vw, 4rem) 0 clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem);
    padding: 1.25rem;
    border: 1px solid var(--rule);
    background: var(--white);
  }

  .article-toc ol {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
    counter-reset: contents;
  }

  .article-toc li {
    position: relative;
    padding-left: 2rem;
    counter-increment: contents;
  }

  .article-toc li::before {
    position: absolute;
    left: 0;
    color: var(--ink-muted);
    font: 700 0.65rem/1.7 var(--font-mono);
    content: counter(contents, decimal-leading-zero);
  }

  .article-toc__nested {
    margin-left: 1rem;
  }

  .article-toc a {
    font-size: 0.83rem;
    line-height: 1.35;
  }

  .article-prose {
    min-width: 0;
    width: min(100% - clamp(2rem, 8vw, 7rem), 48rem);
    padding-block: clamp(3rem, 7vw, 6rem);
    overflow-wrap: anywhere;
  }

  .article-reading-grid--without-toc .article-prose {
    width: min(100% - 2rem, 48rem);
  }

  .article-prose > :first-child {
    margin-top: 0;
  }

  .article-prose h2 {
    margin: 3.5rem 0 1rem;
    font: 800 clamp(2rem, 5vw, 3.25rem) / 1 var(--font-display);
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .article-prose h3 {
    margin: 2.5rem 0 0.75rem;
    font: 800 clamp(1.35rem, 3vw, 1.8rem) / 1.1 var(--font-display);
    text-transform: uppercase;
  }

  .article-prose p,
  .article-prose li {
    color: color-mix(in srgb, var(--cluster) 90%, var(--ink-muted));
  }

  .article-prose a {
    text-decoration-color: var(--rule);
    text-decoration-thickness: 0.12rem;
  }

  .article-prose a:hover {
    text-decoration-color: var(--signal);
  }

  .article-prose blockquote {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border-left: 0.45rem solid var(--signal);
    background: var(--wash);
  }

  .article-prose blockquote > :first-child {
    margin-top: 0;
  }

  .article-prose blockquote > :last-child {
    margin-bottom: 0;
  }

  .article-prose :not(pre) > code {
    padding: 0.12em 0.3em;
    background: var(--wash);
    font-family: var(--font-mono);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .article-prose pre {
    min-width: 0;
    width: 100%;
    overflow-wrap: normal;
  }

  .article-prose pre code {
    font: 0.84rem/1.7 var(--font-mono);
    overflow-wrap: normal;
    word-break: normal;
  }

  .path-neighbors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .path-neighbor {
    display: grid;
    min-height: 9rem;
    padding: 1.5rem;
    align-content: space-between;
    text-decoration: none;
  }

  .path-neighbor + .path-neighbor,
  .path-neighbor--next:first-of-type {
    border-left: 1px solid var(--rule);
  }

  .path-neighbor--next {
    text-align: right;
    grid-column: 2;
  }

  .path-neighbor span {
    color: var(--ink-muted);
    font: 700 0.67rem/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .path-neighbor strong {
    font: 800 clamp(1.25rem, 2.5vw, 1.8rem) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .path-neighbor:hover {
    background: var(--signal);
  }

  .related-posts {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) 0;
  }

  .related-posts__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 58rem) {
    .article-header {
      grid-template-columns: 1fr;
    }

    .article-register {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .article-register dl {
      margin-top: 2rem;
    }

    .article-reading-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-toc {
      position: static;
      margin: 1rem;
    }

    .article-prose {
      width: min(100% - 2rem, 48rem);
      padding-top: 2rem;
    }

    .related-posts__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 40rem) {
    .article-shell {
      border-right: 0;
      border-left: 0;
    }

    .article-header__main h1 {
      font-size: clamp(2.8rem, 15vw, 4.5rem);
    }

    .article-setup,
    .path-neighbors,
    .related-posts__grid {
      grid-template-columns: 1fr;
    }

    .setup-panel + .setup-panel {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .path-neighbor--next {
      grid-column: 1;
    }

    .path-neighbor + .path-neighbor,
    .path-neighbor--next:first-of-type {
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .article-register dl > div {
      grid-template-columns: 5rem 1fr;
    }
  }
</style>
