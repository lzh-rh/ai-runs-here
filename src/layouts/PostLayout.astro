---
import type { MarkdownHeading } from 'astro';
import CodeCopy from '../components/CodeCopy.astro';
import PostCard from '../components/PostCard.astro';
import { topicConfig, withBase } from '../config/site';
import { getPostCollection } from '../lib/post-collection';
import { getRelatedPosts, isPublished, type Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const mode = import.meta.env.PROD ? 'production' : 'development';
const relatedPosts = getRelatedPosts(
  (await getPostCollection()).filter((candidate) => isPublished(candidate, mode)),
  post.id
);
const topic = topicConfig[post.data.topic];
const showEnvironment = post.data.testedVersions.length > 0;
const showPrerequisites = post.data.prerequisites.length > 0;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  publishedDate={post.data.draft ? undefined : post.data.publishedDate}
  updatedDate={post.data.updatedDate}
  article
>
  {tableOfContents.length > 0 && (
    <nav class="contents-nav" aria-label="On this page" slot="contents">
      <h2>On this page</h2>
      <ol>
        {tableOfContents.map((heading) => (
          <li class:list={{ 'contents-nav__nested': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={withBase('/')}>Home</a>
    <span>/</span>
    <a href={withBase(`/topics/${post.data.topic}/`)}>{topic.label}</a>
  </nav>

  <article class="article">
    <header class="article-header">
      <p class="eyebrow">{topic.label}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="article-meta">
        <span>{post.data.draft ? 'Draft preview' : post.data.kind === 'lab' ? 'Lab' : 'Guide'}</span>
        <span>{post.data.difficulty}</span>
        <span>{post.data.estimatedMinutes} minutes</span>
        <time datetime={post.data.publishedDate.toISOString()}>{formatDate(post.data.publishedDate)}</time>
      </p>
    </header>

    {(showEnvironment || showPrerequisites) && (
      <div class="article-setup">
        {showEnvironment && (
          <section aria-labelledby="tested-versions-title">
            <h2 id="tested-versions-title">Tested versions</h2>
            <ul>{post.data.testedVersions.map((version) => <li>{version}</li>)}</ul>
          </section>
        )}
        {showPrerequisites && (
          <section aria-labelledby="prerequisites-title">
            <h2 id="prerequisites-title">Prerequisites</h2>
            <ul>{post.data.prerequisites.map((prerequisite) => <li>{prerequisite}</li>)}</ul>
          </section>
        )}
      </div>
    )}

    <div class="article-prose prose">
      <slot />
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts" aria-labelledby="related-posts-title">
      <h2 id="related-posts-title">Related articles</h2>
      <div class="article-list">{relatedPosts.map((relatedPost) => <PostCard post={relatedPost} />)}</div>
    </section>
  )}

  <CodeCopy />
</BaseLayout>
