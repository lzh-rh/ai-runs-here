---
import type { Post } from '../lib/posts';
import { mcpLabelConfig, topicConfig, withBase } from '../config/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const topic = topicConfig[post.data.topic];
const kind = post.data.kind === 'lab' ? 'Lab' : 'Guide';
const date = post.data.updatedDate ?? post.data.publishedDate;
const formattedDate = new Intl.DateTimeFormat('en', {
  dateStyle: 'medium',
  timeZone: 'UTC'
}).format(date);
---

<article class="post-row">
  <div class="post-row__body">
    <p class="post-row__meta">
      {post.data.draft && <span>Draft preview</span>}
      <span>{topic.label}</span>
      <span>{kind}</span>
      <span>{post.data.estimatedMinutes} min</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </p>
    <h3><a href={withBase(`/articles/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    {post.data.mcpLabels.length > 0 && (
      <p class="post-row__labels">
        {post.data.mcpLabels.map((label) => mcpLabelConfig[label]).join(' · ')}
      </p>
    )}
  </div>
</article>
