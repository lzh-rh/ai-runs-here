---
import { siteConfig } from '../config/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? currentPath === href : currentPath.startsWith(href));
---

<header class="site-header">
  <nav class="site-nav shell" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label={`${siteConfig.title} home`}>
      <span class="site-brand__mark" aria-hidden="true">AI</span>
      <span class="site-brand__name">{siteConfig.title}</span>
    </a>
    <ul class="site-nav__links">
      {siteConfig.navigation.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
