---
import { siteConfig, withBase } from '../config/site';
import SiteNav from './SiteNav.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={withBase('/')} aria-label={`${siteConfig.title} home`}>
      <img
        class="site-brand__icon"
        src={withBase('/red-hat-icon.png')}
        alt=""
        width="70"
        height="60"
      />
      <span class="site-brand__divider" aria-hidden="true"></span>
      <span class="site-brand__text">
        <span>{siteConfig.title}</span>
        <strong>{siteConfig.subtitle}</strong>
      </span>
    </a>
  </div>
  <details class="mobile-topics">
    <summary>Topics</summary>
    <SiteNav />
  </details>
</header>
