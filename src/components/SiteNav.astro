---
import { withBase } from '../config/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  const path = href.split('#')[0];
  return path === withBase('/') ? currentPath === path : currentPath.startsWith(path);
};

const primaryLinks = [
  { label: 'Home', href: withBase('/') },
  { label: 'All articles', href: withBase('/articles/') },
  { label: 'OpenShift Lightspeed', href: withBase('/topics/openshift-lightspeed/') },
  { label: 'Agentic Lightspeed', href: withBase('/topics/agentic-lightspeed/') },
  { label: 'MCP Gateway', href: `${withBase('/topics/mcp/')}#mcp-gateway` },
  { label: 'MCP Server', href: `${withBase('/topics/mcp/')}#mcp-server` },
  { label: 'MCP Lifecycle Operator', href: `${withBase('/topics/mcp/')}#mcp-lifecycle-operator` }
];
---

<nav class="side-nav" aria-label="Topic navigation">
  <p class="side-nav__title">Browse</p>
  <ul>
    {primaryLinks.map((item) => (
      <li>
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>
