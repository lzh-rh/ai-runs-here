---
import { getPublicIntegrationConfig } from '../config/site';

const { buttondownUsername } = getPublicIntegrationConfig(import.meta.env);

if (!buttondownUsername && import.meta.env.PROD) {
  throw new Error(
    'PUBLIC_BUTTONDOWN_USERNAME is required for production builds. Set it to the public Buttondown username.'
  );
}

const action = buttondownUsername
  ? `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(buttondownUsername)}`
  : '';
---

<section class="newsletter section-block" aria-labelledby="newsletter-title">
  <div class="section-heading">
    <h2 id="newsletter-title">Lab notes by email</h2>
    <p>Get new Applied AI field notes when they leave the workbench.</p>
  </div>

  {buttondownUsername ? (
    <form class="newsletter-form" action={action} method="post" data-newsletter-form>
      <label for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        autocomplete="email"
        required
      />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Subscribe</button>
      <p class="newsletter-status" data-newsletter-status aria-live="polite"></p>
    </form>
  ) : (
    <p class="newsletter-setup">
      Newsletter preview: set <code>PUBLIC_BUTTONDOWN_USERNAME</code> to enable subscriptions.
    </p>
  )}
</section>

<script>
  const forms = document.querySelectorAll('[data-newsletter-form]');

  for (const form of forms) {
    if (!(form instanceof HTMLFormElement)) continue;

    const email = form.elements.namedItem('email');
    const status = form.querySelector('[data-newsletter-status]');
    if (!(email instanceof HTMLInputElement) || !(status instanceof HTMLElement)) continue;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form)
        });

        if (!response.ok) throw new Error(`Buttondown returned ${response.status}`);

        email.value = '';
        status.textContent = 'Subscribed. Check your inbox to confirm.';
      } catch {
        status.textContent = 'Subscription did not complete. Check your connection and try again.';
      }
    });
  }
</script>

<style>
  .newsletter-form {
    align-items: end;
  }

  .newsletter-form label {
    flex-basis: 100%;
    font: 700 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .newsletter-form input[type='email'] {
    flex: 1 1 18rem;
    background: var(--paper);
    color: var(--ink);
  }

  .newsletter-form button {
    cursor: pointer;
    background: var(--cluster);
    color: var(--paper);
    font-weight: 800;
  }

  .newsletter-status {
    flex-basis: 100%;
    min-height: 1.5em;
    margin: 0;
    color: var(--ink-muted);
  }

  .newsletter-setup {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
