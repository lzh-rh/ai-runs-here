---
interface Props {
  label: string;
  lines: string[];
  verified: boolean;
}

const { label, lines, verified } = Astro.props;
const headingId = `terminal-status-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<section class="terminal" aria-labelledby={headingId}>
  <div class="terminal__head">
    <h2 class="terminal__label" id={headingId}>{label}</h2>
    <p class:list={['terminal__state', { 'terminal__state--verified': verified }]}>
      {verified ? 'Verified' : 'Experiment in progress'}
    </p>
  </div>
  <ul class="terminal__lines">
    {lines.map((line) => <li>{line}</li>)}
  </ul>
</section>
