---
import { withBase } from '../config/site';

const siteBase = withBase('/');
---

<section class="search" data-search-panel aria-labelledby="search-title">
  <h2 id="search-title">Search articles</h2>
  <label>
    <span class="visually-hidden">Search articles</span>
    <input
      type="search"
      name="q"
      placeholder="Search by title or keyword"
      autocomplete="off"
    />
  </label>
  <p data-search-summary aria-live="polite">Browse all articles below.</p>
  <ol data-search-results hidden></ol>
</section>

<script is:inline type="module" define:vars={{ siteBase }}>
  const root = document.querySelector('[data-search-panel]');
  const staticArticles = document.querySelector('[data-static-article-list]');

  if (root instanceof HTMLElement && staticArticles instanceof HTMLElement) {
    const input = root.querySelector('input[type="search"]');
    const summary = root.querySelector('[data-search-summary]');
    const resultList = root.querySelector('[data-search-results]');

    if (
      input instanceof HTMLInputElement &&
      summary instanceof HTMLElement &&
      resultList instanceof HTMLOListElement
    ) {
      let pagefindPromise;
      let debounceTimer = 0;
      let requestNumber = 0;

      const siteBaseUrl = new URL(siteBase, document.baseURI);
      const pagefindUrl = new URL('pagefind/pagefind.js', document.baseURI);
      pagefindUrl.pathname = new URL('pagefind/pagefind.js', siteBaseUrl).pathname;

      const loadPagefind = () => {
        pagefindPromise ??= import(pagefindUrl.href);
        return pagefindPromise;
      };

      const resultUrl = (url) => {
        const parsed = new URL(url, window.location.origin);
        const basePath = siteBaseUrl.pathname.replace(/^\/+|\/+$/g, '');
        let path = parsed.pathname.replace(/^\/+/, '');
        if (basePath && path.startsWith(`${basePath}/`)) path = path.slice(basePath.length + 1);
        const resolved = new URL(path, siteBaseUrl);
        resolved.search = parsed.search;
        resolved.hash = parsed.hash;
        return resolved.href;
      };

      const showPublishedArticles = () => {
        staticArticles.hidden = false;
        resultList.hidden = true;
        resultList.replaceChildren();
        summary.textContent = 'Browse all articles below.';
      };

      const showFallback = () => {
        staticArticles.hidden = false;
        resultList.hidden = true;
        resultList.replaceChildren();
        summary.textContent = 'Search is unavailable. Browse all articles below.';
      };

      const appendText = (parent, tag, value, className) => {
        if (!value) return;
        const element = document.createElement(tag);
        if (className) element.className = className;
        element.textContent = value;
        parent.append(element);
      };

      const renderResults = (results) => {
        const fragment = document.createDocumentFragment();

        for (const result of results) {
          const item = document.createElement('li');
          const article = document.createElement('article');
          const title = document.createElement('h3');
          const link = document.createElement('a');
          const meta = result.meta ?? {};

          link.href = resultUrl(result.url);
          link.textContent = meta.title || 'Untitled article';
          title.append(link);
          article.append(title);
          appendText(article, 'p', meta.description, 'search__description');

          const details = document.createElement('p');
          details.className = 'search__metadata';
          appendText(details, 'span', meta.topic);
          if (meta.date) {
            const date = document.createElement('time');
            date.textContent = meta.date;
            details.append(date);
          }
          if (details.childElementCount > 0) article.append(details);
          appendText(article, 'p', meta.mcpLabels, 'search__labels');

          item.append(article);
          fragment.append(item);
        }

        resultList.replaceChildren(fragment);
        staticArticles.hidden = true;
        resultList.hidden = false;
        summary.textContent =
          results.length === 0
            ? 'No articles match your search.'
            : results.length === 1
              ? '1 article found.'
              : `${results.length} articles found.`;
      };

      const runSearch = async (query, currentRequest) => {
        try {
          const pagefind = await loadPagefind();
          if (currentRequest !== requestNumber) return;
          const response = await pagefind.search(query);
          const results = await Promise.all(response.results.map((result) => result.data()));
          if (currentRequest === requestNumber) renderResults(results);
        } catch (error) {
          console.error('Article search is unavailable.', error);
          if (currentRequest === requestNumber) showFallback();
        }
      };

      const scheduleSearch = () => {
        window.clearTimeout(debounceTimer);
        const currentRequest = ++requestNumber;
        const query = input.value.trim();

        if (!query) {
          showPublishedArticles();
          return;
        }

        debounceTimer = window.setTimeout(() => void runSearch(query, currentRequest), 150);
      };

      input.addEventListener('input', scheduleSearch);
    }
  }
</script>

<style>
  .search {
    width: min(100%, var(--reading-max));
  }

  .search h2 {
    margin-bottom: 1rem;
  }

  .search label,
  .search input {
    display: block;
    width: 100%;
  }

  .search input {
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--border);
    color: var(--text-primary);
    background: var(--surface);
  }

  .search [data-search-summary] {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
  }

  .search ol {
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .search :global(li) {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .search :global(h3),
  .search :global(p) {
    margin: 0;
  }

  .search :global(.search__description) {
    margin-top: 0.75rem;
    color: var(--text-secondary);
  }

  .search :global(.search__metadata),
  .search :global(.search__labels) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
