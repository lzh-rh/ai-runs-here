---
import { topicConfig } from '../config/site';

const topics = Object.entries(topicConfig);
---

<nav class="topic-rail" aria-label="Browse by topic">
  {topics.map(([id, topic], index) => (
    <a href={`/articles/?topic=${encodeURIComponent(id)}`}>
      <span class="topic-rail__index" aria-hidden="true">TOPIC {String(index + 1).padStart(2, '0')}</span>
      <span class="topic-rail__label">{topic.label}</span>
      <span class="topic-rail__description">{topic.description}</span>
    </a>
  ))}
</nav>
