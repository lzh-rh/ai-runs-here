<figure class="agentic-workflow" aria-labelledby="agentic-workflow-title">
  <figcaption id="agentic-workflow-title">Alert-triggered Agentic troubleshooting flow</figcaption>
  <ol class="agentic-workflow__flow">
    <li data-workflow-step>
      <span class="agentic-workflow__label">Signal</span>
      <strong>Prometheus / Thanos Ruler</strong>
      <small>Evaluates alerting rules</small>
    </li>
    <li data-workflow-step>
      <span class="agentic-workflow__label">Alert</span>
      <strong>Alertmanager</strong>
      <small>Holds firing alerts</small>
    </li>
    <li data-workflow-step>
      <span class="agentic-workflow__label">Create work order</span>
      <strong>Agentic Alerts Adapter</strong>
      <small>Checks alert rules and creates a work order</small>
    </li>
    <li class="agentic-workflow__handoff" data-workflow-step>
      <span class="agentic-workflow__label">Kubernetes API</span>
      <strong>AgenticRun</strong>
      <small>Stores the request, progress, and results</small>
    </li>
    <li data-workflow-step>
      <span class="agentic-workflow__label">Manage</span>
      <strong>Lightspeed Agentic Operator</strong>
      <small>Watches the run and starts each stage</small>
    </li>
    <li data-workflow-step>
      <span class="agentic-workflow__label">Investigate</span>
      <strong>Analysis sandbox</strong>
      <small>Collects evidence and proposes options</small>
    </li>
    <li class="agentic-workflow__stages" data-workflow-step>
      <span class="agentic-workflow__label">Approved action</span>
      <div>
        <strong>Approval gate</strong>
        <span aria-hidden="true">→</span>
        <strong>Execution sandbox</strong>
        <span aria-hidden="true">→</span>
        <strong>Verification sandbox</strong>
      </div>
      <small>Approve one option, apply it with limited access, and check recovery</small>
    </li>
  </ol>
  <p class="agentic-workflow__return">The workers save their results and status in the Kubernetes API.</p>
</figure>
