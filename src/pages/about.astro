---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../config/site';
---

<BaseLayout
  title="About"
  description="About AI Runs Here, a personal publication focused on Applied AI in OpenShift."
>
  <article class="page-article about-page">
      <p class="breadcrumb"><a href={withBase('/')}>Home</a> / About</p>
      <h1>About AI Runs Here</h1>
      <p class="about-page__intro">Li is a Technical Marketing Manager focused on Applied AI in OpenShift.</p>
      <p>
        AI Runs Here shares practical notes from learning about OpenShift Lightspeed, agentic systems, and MCP.
        Articles distinguish verified observations from work that still needs testing.
      </p>
      <h2>Personal and unofficial</h2>
      <p>
        AI Runs Here is a personal learning publication and is not an official Red Hat website. Product
        documentation remains the source of record.
      </p>
  </article>
</BaseLayout>
