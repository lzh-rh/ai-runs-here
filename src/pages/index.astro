---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PostCard from '../components/PostCard.astro';
import TerminalStatus from '../components/TerminalStatus.astro';
import TopicRail from '../components/TopicRail.astro';
import { learningPathConfig, siteConfig } from '../config/site';
import { getFeaturedPost, getLearningPathGroups, isPublished, sortNewest } from '../lib/posts';

type LearningPathId = keyof typeof learningPathConfig;

const mode = import.meta.env.PROD ? 'production' : 'development';
const posts = (await getCollection('posts')).filter((post) => isPublished(post, mode));
const featuredPost = getFeaturedPost(posts);
const recentPosts = sortNewest(posts).filter((post) => post.id !== featuredPost?.id).slice(0, 4);
const learningPathGroups = getLearningPathGroups(posts);
const learningPaths = (Object.keys(learningPathConfig) as LearningPathId[])
  .map((id) => ({
    id,
    ...learningPathConfig[id],
    posts: learningPathGroups.get(id) ?? []
  }))
  .filter(({ posts }) => posts.length > 0);
---

<BaseLayout>
  <div class="shell">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero__main">
        <p class="eyebrow">Applied AI on OpenShift · Field notes 001–∞</p>
        <h1 class="display hero__title" id="home-title">Applied AI, step by step.</h1>
        <p class="hero__promise">{siteConfig.description}</p>
      </div>
      <aside class="hero__aside" aria-label="Current lab status">
        <p class="eyebrow">Current bench note</p>
        <TerminalStatus
          label="MCP to Lightspeed"
          lines={[
            'Scope: connection workflow',
            'Evidence: pending a live lab run',
            'Next: record exact versions and output'
          ]}
          verified={false}
        />
      </aside>
    </section>

    <TopicRail />

    <section class="section-block" aria-labelledby="field-notes-title">
      <div class="section-heading">
        <h2 id="field-notes-title">Field notes from the workbench</h2>
        <p>Practical walkthroughs and explanations that separate observed results from the next thing to test.</p>
      </div>
      {featuredPost ? (
        <div class="post-grid">
          <PostCard post={featuredPost} featured />
          {recentPosts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p>No published field notes yet. The first lab is still on the workbench.</p>
      )}
    </section>

    {learningPaths.length > 0 && (
      <section class="section-block" aria-labelledby="learning-paths-title">
        <div class="section-heading">
          <h2 id="learning-paths-title">Follow a learning path</h2>
          <p>
            {mode === 'development'
              ? 'Preview related field notes in order; draft cards are clearly marked.'
              : 'Move through related published field notes in a deliberate order.'}
          </p>
        </div>
        <div class="home-path-grid">
          {learningPaths.map((path) => (
            <article class="home-path-card">
              <p class="eyebrow">{path.posts.length} {path.posts.length === 1 ? 'step' : 'steps'}</p>
              <h3>{path.label}</h3>
              <p>{path.description}</p>
              <a href={`/learning-paths/#path-${path.id}`}>Explore the learning path <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </section>
    )}

    <NewsletterForm />
  </div>
</BaseLayout>
