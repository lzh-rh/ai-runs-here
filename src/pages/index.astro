---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig, topicConfig, withBase } from '../config/site';
import { getPostCollection } from '../lib/post-collection';
import { isPublished, sortNewest } from '../lib/posts';

const mode = import.meta.env.PROD ? 'production' : 'development';
const posts = sortNewest(
  (await getPostCollection()).filter((post) => isPublished(post, mode))
).slice(0, 5);
const topicEntries = Object.entries(topicConfig);
---

<BaseLayout>
  <article class="page-article home-page">
    <header>
      <p class="eyebrow">{siteConfig.subtitle}</p>
      <h1>{siteConfig.title}</h1>
      <p class="lead">Practical, follow-along notes on OpenShift Lightspeed, agentic systems, and MCP.</p>
    </header>

    <section aria-labelledby="topics-title">
      <h2 id="topics-title">Topics</h2>
      <ul class="topic-links">
        {topicEntries.map(([slug, topic]) => (
          <li>
            <a href={withBase(`/topics/${slug}/`)}>{topic.label}</a>
            <span>{topic.description}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="newest-title">
      <h2 id="newest-title">Newest articles</h2>
      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p>Articles are coming.</p>
      )}
    </section>
  </article>
</BaseLayout>
