---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TopicRail from '../components/TopicRail.astro';
import { siteConfig } from '../config/site';
import { getPostCollection } from '../lib/post-collection';
import { getFeaturedPost, isPublished, sortNewest } from '../lib/posts';

const mode = import.meta.env.PROD ? 'production' : 'development';
const posts = (await getPostCollection()).filter((post) => isPublished(post, mode));
const featuredPost = getFeaturedPost(posts);
const recentPosts = sortNewest(posts).filter((post) => post.id !== featuredPost?.id).slice(0, 4);
---

<BaseLayout>
  <div class="shell">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero__main">
        <p class="eyebrow">Applied AI on OpenShift · Field notes 001–∞</p>
        <h1 class="display hero__title" id="home-title">Applied AI, step by step.</h1>
        <p class="hero__promise">{siteConfig.description}</p>
      </div>
    </section>

    <TopicRail />

    <section class="section-block" aria-labelledby="field-notes-title">
      <div class="section-heading">
        <h2 id="field-notes-title">Field notes from the workbench</h2>
        <p>Practical walkthroughs and explanations that separate observed results from the next thing to test.</p>
      </div>
      {featuredPost ? (
        <section class="article-list" aria-label="Featured and recent field notes">
          <PostCard post={featuredPost} featured />
          {recentPosts.map((post) => <PostCard post={post} />)}
        </section>
      ) : (
        <p>No published field notes yet. The first lab is still on the workbench.</p>
      )}
    </section>
  </div>
</BaseLayout>
