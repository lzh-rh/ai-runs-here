---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { mcpLabelConfig, siteConfig, topicConfig, withBase } from '../config/site';
import { getPostCollection } from '../lib/post-collection';
import { isPublished, sortNewest } from '../lib/posts';

const mode = import.meta.env.PROD ? 'production' : 'development';
const posts = sortNewest(
  (await getPostCollection()).filter((post) => isPublished(post, mode))
).slice(0, 5);
const topicEntries = Object.entries(topicConfig);
const mcpLabels = Object.values(mcpLabelConfig).join(' · ');
---

<BaseLayout>
  <section class="home-intro section">
    <div class="shell reading-column">
      <p class="kicker">{siteConfig.subtitle}</p>
      <h1>Learn by building.</h1>
      <p class="home-intro__summary">Practical notes on OpenShift Lightspeed, agentic systems, and MCP.</p>
    </div>
  </section>

  <section class="section section--bordered" aria-labelledby="topics-title">
    <div class="shell">
      <h2 id="topics-title">Topics</h2>
      <div class="topic-list">
        {topicEntries.map(([slug, topic]) => (
          <article class="topic-row">
            <h3><a href={withBase(`/topics/${slug}/`)}>{topic.label}</a></h3>
            {slug === 'mcp' ? <p>— {mcpLabels}</p> : <p>{topic.description}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="newest-title">
    <div class="shell">
      <h2 id="newest-title">Newest articles</h2>
      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p>Articles are coming.</p>
      )}
    </div>
  </section>
</BaseLayout>
