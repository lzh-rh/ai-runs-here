---
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostCollection } from '../../lib/post-collection';
import { isPublished, sortNewest } from '../../lib/posts';

const mode = import.meta.env.PROD ? 'production' : 'development';
const posts = sortNewest(
  (await getPostCollection()).filter((post) => isPublished(post, mode))
);
---

<BaseLayout
  title="Articles"
  description="Step-by-step Applied AI articles, newest first."
>
  <article class="page-article articles-page">
    <header>
      <p class="breadcrumb"><a href={withBase('/')}>Home</a> / Articles</p>
      <h1>Articles</h1>
      <p>
        {mode === 'development'
          ? 'Published notes and clearly marked draft previews, newest first.'
          : 'Practical notes, newest first.'}
      </p>
    </header>
    <section data-static-article-list aria-labelledby="all-articles-title">
      <div class="articles-page__list-heading">
        <h2 id="all-articles-title">All articles</h2>
        <p>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
      </div>
      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p>No published articles yet. Check back soon.</p>
      )}
    </section>
  </article>
</BaseLayout>
