    "@astrojs/vercel": "^11.0.3",
    "astro": "^7.1.1",
    "pagefind": "^1.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "cheerio": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
